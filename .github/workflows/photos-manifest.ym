name: Build photos.json
on:
  push:
    paths:
      - 'gallery/**'
      - '!gallery/photos.json'
jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with: { node-version: '20' }
      - run: node build-manifest.mjs
      - uses: stefanzweifel/git-auto-commit-action@v5
        with:
          commit_message: 'chore: regenerate gallery/photos.json'
          file_pattern: gallery/photos.json